          "source_text": "def _pattern_scan_finish(LocalValues, LocalIndices, Carry, CarryIndices, Values, Indices,\n                         AXIS: tl.constexpr, INNER: tl.constexpr, CHUNKS: tl.constexpr, BLOCK: tl.constexpr):\n    chunk = tl.program_id(0)\n    line = tl.program_id(1)\n    positions = chunk * BLOCK + tl.arange(0, BLOCK)\n    base = line // INNER * AXIS * INNER + line % INNER\n    local = tl.load(LocalValues + base + positions * INNER, positions < AXIS, other=float('inf'))\n    local_index = tl.load(LocalIndices + base + positions * INNER, positions < AXIS, other=-1)\n    carry = tl.load(Carry + line * CHUNKS + chunk)\n    carry_index = tl.load(CarryIndices + line * CHUNKS + chunk)\n    take_carry = (carry < local) | ((carry == local) & (carry_index > local_index))\n    tl.store(Values + base + positions * INNER, tl.where(take_carry, carry, local), positions < AXIS)\n    tl.store(Indices + base + positions * INNER, tl.where(take_carry, carry_index, local_index), positions < AXIS)\n",
